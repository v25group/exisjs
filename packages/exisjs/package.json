{
  "name": "exisjs",
  "version": "0.7.4",
  "description": "efficient full-stack web framework for Node.js",
  "author": "V25 Group <support@v25group.com>",
  "keywords": [
    "exis",
    "exisjs",
    "framework",
    "nodejs",
    "typescript",
    "backend",
    "api",
    "rpc",
    "type-safe"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "default": "./dist/router/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./module": {
      "types": "./dist/module/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./di": {
      "types": "./dist/di/index.d.ts",
      "default": "./dist/di/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "default": "./dist/decorators/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "default": "./dist/database/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/middleware.d.ts",
      "default": "./dist/middleware/middleware.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./error": {
      "types": "./dist/error/index.d.ts",
      "default": "./dist/error/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./response": {
      "types": "./dist/response/index.d.ts",
      "default": "./dist/response/index.js"
    },
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "default": "./dist/validator/index.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize/index.d.ts",
      "default": "./dist/sanitize/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').cpSync('../../docs', './dist/docs', {recursive:true, force:true})\"",
    "dev": "tsc --watch",
    "test": "cross-env NODE_ENV=test tsx --test --test-reporter=./src/testing/reporter.mts tests/**/*.test.ts"
  },
  "bin": {
    "exisjs": "bin/exis.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v25group/exisjs.git"
  },
  "dependencies": {
    "@exisjs/rs": "*",
    "@exisjs/telemetry": "^0.7.0",
    "accepts": "^1.3.8",
    "busboy": "^1.6.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "content-disposition": "^2.0.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "esbuild": "^0.28.2",
    "execa": "^10.0.1",
    "fast-json-stringify": "^7.0.1",
    "fast-querystring": "^1.1.2",
    "fresh": "^0.5.2",
    "fs-extra": "^11.4.0",
    "mime-types": "^3.0.2",
    "ora": "^9.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/accepts": "^1.3.7",
    "@types/autocannon": "^7.12.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.0",
    "@types/busboy": "^1.5.4",
    "@types/content-disposition": "^0.5.9",
    "@types/fresh": "^0.5.3",
    "@types/mime-types": "^3.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "find-my-way": "^9.9.0",
    "mitata": "^1.0.34"
  },
  "optionalDependencies": {
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.70.0"
  }
}
