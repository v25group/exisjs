{
  "name": "exisjs",
  "version": "0.10.0-beta.0",
  "description": "Fast, lightweight TypeScript backend framework for Node.js with file-system routing, built-in validation, dependency injection and OpenAPI docs",
  "keywords": [
    "exisjs",
    "exis",
    "framework",
    "web-framework",
    "http",
    "server",
    "api",
    "rest",
    "backend",
    "typescript",
    "nodejs",
    "router",
    "validation",
    "dependency-injection",
    "openapi",
    "swagger",
    "type-safe"
  ],
  "homepage": "https://github.com/v25group/exisjs/tree/main/packages/exisjs#readme",
  "bugs": {
    "url": "https://github.com/v25group/exisjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v25group/exisjs.git",
    "directory": "packages/exisjs"
  },
  "license": "MIT",
  "author": "V25 Group <support@v25group.com>",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "default": "./dist/router/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./module": {
      "types": "./dist/module/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./di": {
      "types": "./dist/di/index.d.ts",
      "default": "./dist/di/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "default": "./dist/decorators/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "default": "./dist/database/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/middleware.d.ts",
      "default": "./dist/middleware/middleware.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./error": {
      "types": "./dist/error/index.d.ts",
      "default": "./dist/error/index.js"
    },
    "./cron": {
      "types": "./dist/cron/index.d.ts",
      "default": "./dist/cron/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./response": {
      "types": "./dist/response/index.d.ts",
      "default": "./dist/response/index.js"
    },
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "default": "./dist/validator/index.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize/index.d.ts",
      "default": "./dist/sanitize/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    },
    "./swagger": {
      "types": "./dist/swagger/index.d.ts",
      "default": "./dist/swagger/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./start": {
      "types": "./dist/lib/start-server.d.ts",
      "default": "./dist/lib/start-server.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "router": [
        "dist/router/index.d.ts"
      ],
      "app": [
        "dist/app/index.d.ts"
      ],
      "module": [
        "dist/module/index.d.ts"
      ],
      "di": [
        "dist/di/index.d.ts"
      ],
      "decorators": [
        "dist/decorators/index.d.ts"
      ],
      "database": [
        "dist/database/index.d.ts"
      ],
      "middleware": [
        "dist/middleware/middleware.d.ts"
      ],
      "testing": [
        "dist/testing/index.d.ts"
      ],
      "config": [
        "dist/config/index.d.ts"
      ],
      "error": [
        "dist/error/index.d.ts"
      ],
      "cron": [
        "dist/cron/index.d.ts"
      ],
      "plugin": [
        "dist/plugin/index.d.ts"
      ],
      "response": [
        "dist/response/index.d.ts"
      ],
      "validator": [
        "dist/validator/index.d.ts"
      ],
      "sanitize": [
        "dist/sanitize/index.d.ts"
      ],
      "logger": [
        "dist/logger/index.d.ts"
      ],
      "swagger": [
        "dist/swagger/index.d.ts"
      ],
      "telemetry": [
        "dist/telemetry/index.d.ts"
      ],
      "internal": [
        "dist/internal.d.ts"
      ],
      "start": [
        "dist/lib/start-server.d.ts"
      ]
    }
  },
  "bin": {
    "exis": "bin/exis.js",
    "exisjs": "bin/exis.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true}); require('fs').rmSync('tsconfig.tsbuildinfo', {force:true})\"",
    "build": "tsc",
    "postbuild": "node -e \"require('fs').cpSync('../../docs', './dist/docs', {recursive:true, force:true})\"",
    "dev": "tsc --watch",
    "test": "cross-env NODE_ENV=test tsx --tsconfig ../../tsconfig.base.json --test --test-reporter=./src/testing/reporter.mts tests/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "accepts": "^1.3.8",
    "busboy": "^1.6.0",
    "content-disposition": "^2.0.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "fast-querystring": "^1.1.2",
    "mime-types": "^3.0.2",
    "pino": "^10.4.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "pino-pretty": ">=11",
    "uWebSockets.js": ">=20.71.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "@opentelemetry/auto-instrumentations-node": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/semantic-conventions": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    },
    "uWebSockets.js": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@exisjs/cli": "0.10.0-beta.0"
  },
  "devDependencies": {
    "@types/accepts": "^1.3.7",
    "@types/bun": "^1.4.3",
    "@types/busboy": "^1.5.5",
    "@types/content-disposition": "^0.5.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.4.0",
    "fast-json-stringify": "^7.1.2",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
