{
  "name": "@exisjs/telemetry",
  "version": "0.5.0",
  "description": "Zero-Config OpenTelemetry Integration for ExisJS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "cross-env NODE_ENV=test tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "exis",
    "exisjs",
    "telemetry",
    "opentelemetry",
    "observability",
    "tracing"
  ],
  "author": "V25 Group <support@v25group.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v25group/exisjs.git"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@opentelemetry/auto-instrumentations-node": "^0.49.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/sdk-trace-node": "^1.25.1",
    "@opentelemetry/resources": "^1.25.1",
    "@opentelemetry/semantic-conventions": "^1.25.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
