{
  "name": "exis",
  "version": "0.1.2",
  "private": true,
  "description": "Exis workspace",
  "author": "V25 Group <support@v25group.com>",
  "keywords": [
    "exis",
    "exisjs",
    "framework",
    "nodejs",
    "typescript",
    "backend",
    "api",
    "rpc",
    "type-safe"
  ],
  "workspaces": [
    "packages/*",
    "examples/*",
    "examples/*/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/exis --workspace=packages/create-exis",
    "dev": "npm run dev --workspaces --if-present",
    "test": "jest",
    "lint": "eslint .",
    "prepare": "husky",
    "release": "npm run build && changeset publish",
    "bench": "tsx bench/basic.ts",
    "bench:compare": "tsx bench/compare.ts",
    "bench:router": "tsx bench/router.ts"
  },
  "lint-staged": {
    "packages/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.0.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "autocannon": "^8.0.0",
    "eslint": "^10.8.0",
    "express": "^5.2.1",
    "fastify": "^5.10.0",
    "hono": "^4.12.32",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "ts-jest": {
      "typescript": "$typescript"
    }
  }
}
