{
  "name": "exis",
  "version": "0.2.1",
  "private": true,
  "description": "Exis workspace",
  "author": "V25 Group <support@v25group.com>",
  "keywords": [
    "exis",
    "exisjs",
    "framework",
    "nodejs",
    "typescript",
    "backend",
    "api",
    "rpc",
    "type-safe"
  ],
  "workspaces": [
    "packages/*",
    "examples/*",
    "examples/*/*"
  ],
  "scripts": {
    "version": "node scripts/update-templates.mjs",
    "build": "npm run build --workspace=packages/exis --workspace=packages/create-exis",
    "dev": "npm run dev --workspaces --if-present",
    "test": "cross-env NODE_ENV=test tsx --test \"packages/*/tests/**/*.test.ts\"",
    "test:watch": "cross-env NODE_ENV=test tsx --test --watch \"packages/*/tests/**/*.test.ts\"",
    "lint": "eslint .",
    "prepare": "husky",
    "release": "npm run build && npm publish --workspaces --access public",
    "bench": "tsx bench/basic.ts",
    "bench:compare": "tsx bench/compare.ts",
    "bench:router": "tsx bench/router.ts"
  },
  "lint-staged": {
    "packages/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.0.11",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "express": "^5.2.1",
    "fastify": "^5.10.0",
    "hono": "^4.12.32",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "ts-jest": {
      "typescript": "$typescript"
    }
  }
}
